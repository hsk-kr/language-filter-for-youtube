{
  "manifest_version": 3,
  "name": "Language Filter for YouTube",
  "version": "0.0.0",
  "description": "Keep your native language out of your YouTube feed: auto-marks videos in chosen languages as Not interested. For immersion learners.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
